#ifndef <MOD>_API_H
#define <MOD>_API_H

#ifdef __cplusplus
extern "C" {
#endif

/*
 * TASK/<MOD> C ABI public header.
 *
 * Phase L-2 status: function symbols are present in lib<MODULE>api (built
 * from <MODULE>_api.f90); each entry point is a stub returning
 * <MOD>_ERR_NOT_IMPL (=4). Real bodies arrive in Phase L-3.
 *
 * Memory note: in C, RN[NRMAX][NSMAX] is row-major; in Fortran the
 * matching declaration is RN(NSMAX, NRMAX) (column-major). Layouts
 * agree byte-for-byte, but only RN[0..nrmax-1][0..nsmax-1] are valid
 * runtime values (the remainder is padding up to <MOD>_MAX_*).
 */

#define <MOD>_MAX_NRMAX 500
#define <MOD>_MAX_NSMAX 8

/* Error codes returned by every <MODULE>_* entry point. */
enum <MODULE>_error {
    <MOD>_OK              = 0,
    <MOD>_ERR_INVALID     = 1,  /* invalid parameter name or value     */
    <MOD>_ERR_NOT_INIT    = 2,  /* <MODULE>_init has not been called   */
    <MOD>_ERR_CALC_FAILED = 3,  /* calculation / initialization failed */
    <MOD>_ERR_NOT_IMPL    = 4   /* L-2 stub return: not implemented    */
};

typedef struct {
    int    nt, nrmax, nsmax;
    double T;
    /* ... add scalar fields mirroring <MODULE>_state.f90 ... */
    double RN[<MOD>_MAX_NRMAX][<MOD>_MAX_NSMAX];
    double RT[<MOD>_MAX_NRMAX][<MOD>_MAX_NSMAX];
    double AJ[<MOD>_MAX_NRMAX];
    double QP[<MOD>_MAX_NRMAX];
} <MODULE>_state_t;

int <MODULE>_init(void);
int <MODULE>_run(int n);
int <MODULE>_set_param(const char *name, double value);
int <MODULE>_set_param_str(const char *name, const char *value);
int <MODULE>_get_state(<MODULE>_state_t *state);
int <MODULE>_finalize(void);

#ifdef __cplusplus
}
#endif

#endif /* <MOD>_API_H */
