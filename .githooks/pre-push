#!/bin/sh
# Pre-push gate of this repository (CLAUDE.md "Pre-push gate", AGENTS.md).
# Installed by scripts/install-hooks.sh as a COPY under the shared git
# directory, so that it runs in every worktree whatever branch is checked
# out there (a topic branch from upstream develop has no .githooks/).
# scripts/pre-push.sh is upstream's older form of rule 2 and is left as it is.
#
# 1. kyoshimi-develop of the product repository (github.com/HengyuLi-Ozaki-lab/task)
#    changes only through pull requests. GitHub refuses such a push itself (a
#    ruleset on that repository, .github/rulesets/kyoshimi-develop.json); this
#    says so earlier and names the way in. Another remote's branch of that name
#    is an ordinary push. The repository is recognised by the push URL (https,
#    ssh or git URL, or an scp-like [user@]github.com:..., with or without user,
#    port, .git or a trailing /; host github.com, www.github.com or
#    ssh.github.com), not by the remote's name. A local path, a file:// URL or an
#    ssh host alias that hides github.com is not recognised. GitHub's ruleset is
#    the authority for any unusual spelling of the URL: this match is an early
#    message, not the gate.
# 2. Every pushed ref tip needs a review marker REVIEW_OK_<sha> under the shared
#    git directory (`git rev-parse --git-common-dir`), written after the local
#    pytest run and the two reviews CLAUDE.md asks for: the marker of the commit
#    each pushed ref points at, whichever branch is checked out. An annotated
#    tag is gated by the marker of the commit it points to (it adds no code). A
#    deletion pushes nothing and needs none.
#    SKIP_PREPUSH_REVIEW=1 skips rule 2 only and logs a line to
#    REVIEW_OVERRIDES.log there (SKIP_PREPUSH_REVIEW_REASON says why).
set -eu

git_common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd)
product=0
# The push URL, lower-cased, with scheme, user and a recognised host (github.com,
# www.github.com or ssh.github.com, with an optional :port) replaced by the sentinel GH/
# (upper case, so no lower-cased URL can contain it), then a trailing / and .git removed
# and repeated slashes collapsed. It is the fork only if the result is GH/<owner>/<repo>
# of the fork: a URL whose host was not recognised never equals that, whatever else it
# spells. Only an https, http, ssh or git URL (also git+ssh and ssh+git; host, optional
# :port, then /path) or an scp-like [user@]host:path (no port: a number after the colon
# is the first path component) is taken apart; anything else (a local path, file://,
# another scheme) is empty and matches nothing.
url=$(printf '%s' "${2:-}" | tr 'A-Z' 'a-z')
host=
case "$url" in
    https://*|http://*|ssh://*|git://*|git+ssh://*|ssh+git://*) url=${url#*://}; host='github\.com\(:[0-9][0-9]*\)\{0,1\}/' ;;
    *://*|/*|./*|../*) url= ;;
    *:*) host='github\.com:/*' ;;
    *) url= ;;
esac
repo=$(printf '%s' "$url" | sed \
    -e 's|^[^/@]*@||' \
    -e "s|^\(ssh\.\)\{0,1\}$host/*|GH/|" -e "s|^www\.$host/*|GH/|" \
    -e 's|//*|/|g' -e 's|/*$||' -e 's|\.git$||')
[ "$repo" != "GH/hengyuli-ozaki-lab/task" ] || product=1
unreadable() {
    echo "pre-push: REFUSED -- cannot read the line git passed (wanted: <local ref> <local sha> <remote ref> <remote sha>): $line" >&2
    exit 1
}
is_object_name() {      # 40 (sha-1) or 64 (sha-256) lower-case hex digits
    case "$1" in *[!0-9a-f]*|"") return 1 ;; esac
    [ "${#1}" = 40 ] || [ "${#1}" = 64 ]
}
status=0
shas=""
while IFS= read -r line || [ -n "$line" ]; do
    # Git writes the local ref as the user typed it, spaces included (HEAD@{0 minutes ago}),
    # so the line is split from the RIGHT: the three fields after it never contain a space.
    case "$line" in *" "*" "*" "*) ;; *) unreadable ;; esac
    remote_sha=${line##* }; rest=${line% *}
    remote_ref=${rest##* }; rest=${rest% *}
    local_sha=${rest##* }; local_ref=${rest% *}
    [ -n "$local_ref" ] && [ -n "$remote_ref" ] && is_object_name "$local_sha" && is_object_name "$remote_sha" || unreadable
    if [ "$product" = 1 ] && [ "$remote_ref" = "refs/heads/kyoshimi-develop" ]; then
        echo "pre-push: REFUSED -- kyoshimi-develop changes only through pull requests (AGENTS.md):" >&2
        echo "  gh pr create -R HengyuLi-Ozaki-lab/task --base kyoshimi-develop --head <your branch>" >&2
        status=1
    fi
    case "$local_sha" in
        *[!0]*) shas="$shas $local_sha" ;;      # all zeros: a deletion
    esac
done
[ "$status" = 0 ] || exit 1
[ -n "$shas" ] || exit 0

if [ "${SKIP_PREPUSH_REVIEW:-0}" = 1 ]; then
    for sha in $shas; do
        printf "%s  SHA=%s  reason=%s\n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sha" \
            "${SKIP_PREPUSH_REVIEW_REASON:-unspecified}" >> "$git_common_dir/REVIEW_OVERRIDES.log"
    done
    echo "pre-push: SKIP_PREPUSH_REVIEW=1 set -- skipping review gate (logged)" >&2
    exit 0
fi

for sha in $shas; do
    commit=$(git rev-parse --verify --quiet "$sha^{commit}" 2>/dev/null) || commit=$sha
    marker="$git_common_dir/REVIEW_OK_$commit"
    if [ ! -f "$marker" ]; then
        cat >&2 <<MSG
============================================================
pre-push: REFUSED -- no review marker for $(printf %.12s "$commit")

Per CLAUDE.md "Pre-push gate", before a push:
  1. Run local pytest with CI-equivalent flags
  2. Run the code review and the Codex review on the diff
     (a sync merge: the change packet AGENTS.md describes)
  3. Address HIGH / MED findings
  4. touch "$marker"

Escape hatch (rare, the author's):
  SKIP_PREPUSH_REVIEW=1 SKIP_PREPUSH_REVIEW_REASON='...' git push ...
============================================================
MSG
        status=1
    fi
done
[ "$status" = 0 ] && echo "pre-push: review marker present -- OK" >&2
exit $status
