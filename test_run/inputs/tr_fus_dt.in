0
f
tr_fus_dt.gs
c
! DT-fusion regression case (model_pnf=1) for kyoshimi TR.
! Physically equivalent to the bpsi trx reference capture in
! test_run/baselines/tr_fus_dt/ (see SOURCE.md).  Analytic geometry
! (modelg=2, self-contained, no eq dependency); species e/D/T/He4.
!
! NOT byte-identical to the reference deck, and must not be made so: PROFN2
! is a bare scalar here and PROFN2(NSM) in trx, so the single value below
! covers every species while the reference deck spells all four out.
! Writing four values here still "works" -- gfortran assigns as it parses,
! so the first lands and the rest raise a cosmetic `## PARM INPUT ERROR.`
! -- which makes the mistake invisible.  Leave it as one value.
!
! This is the WEAK companion to tr_fus_dt_hot, which is the primary Task 7
! oracle.  Its fusion signal is rel WPT 6.2e-9 -- 62x the 1e-10 tolerance,
! against the hot deck's 1.1e7x.  model_pnf landed in 553b86a4, so the case
! runs end-to-end; it is registered in test_definitions.conf (which no
! pytest/CI job reads) and is expected to report REGRESSION there, because it
! does not match at 1e-10 for reasons outside fusion.
! NTMAX=5 is kept from the original capture.  The NTMAX>=12 ill-conditioning
! that used to make it mandatory was an artefact of a 1e6 unit error in the
! reference and has not been re-measured -- see SOURCE.md, "Numerical
! conditioning", which is marked superseded.
   modelg=2
   RR=8.481D0
   RA=2.574D0
   RKAP=1.816D0
   RDLT=0.3478D0
   BB=5.953D0
   NSMAX=4
   PN=0.1D0,0.045D0,0.045D0,0.005D0
   PNS=0.01D0,0.0045D0,0.0045D0,0.0005D0
   PT=1.0D0,1.0D0,1.0D0,1.0D0
   PTS=0.1D0,0.1D0,0.1D0,0.1D0
   PROFN2=0.15D0
   model_pnf=1
   DT=0.02D0
   NRMAX=50
   NTMAX=5
   NTSTEP=5
   RIPS=2.D0
   RIPE=3.D0
r
q
